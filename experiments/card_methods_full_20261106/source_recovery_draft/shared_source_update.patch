+def load_source_revision_seed(row, card, registry, representation):
+    """Reopen old feedback under old inputs, then permit an additive source update."""
+    from genomics_discovery.illumina.graph import load_reviewed_workflow
+    directory = Path(row['attempt_directory'])
+    old_card, old_registry = read(directory/'card.json'), read(directory/'source_registry.json')
+    if row['status'] not in {'research_needed','needs_revision'}:
+        raise ValueError('Source revision requires a reviewed unfinished candidate')
+    load_reviewed_workflow(row,old_card)
+    if any(registry.get(sid) != value for sid,value in old_registry.items()):
+        raise ValueError('Source revision must preserve every old source byte and registration')
+    if not set(registry)-set(old_registry):
+        raise ValueError('Source revision requires actual newly registered evidence')
+    if ({k:v for k,v in card.items() if k!='references'} !=
+            {k:v for k,v in old_card.items() if k!='references'}):
+        raise ValueError('Source revision cannot change the assigned method scope')
+    if any(ref not in card.get('references',[]) for ref in old_card.get('references',[])):
+        raise ValueError('Source revision cannot delete old reference obligations')
+    verify_registry_files(registry)
+    candidate=parse_extraction((directory/'extraction.json').read_bytes())
+    if candidate.format_version != representation:
+        raise ValueError('Source revision cannot change extraction representation')
+    return candidate,parse_review((directory/'review.json').read_bytes())
