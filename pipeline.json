{
  "format_version": "atlas_pipeline/1",
  "stages": [
    {
      "id": "sources",
      "description": "Collect Illumina cards/diagrams and online literature, screen contributions, acquire and register sources.",
      "depends_on": []
    },
    {
      "id": "extraction",
      "description": "Prepared method sources become reviewed State\u2013Operation\u2013Flow workflows.",
      "depends_on": [
        "sources"
      ]
    },
    {
      "id": "evolution",
      "description": "Investigate primary papers and citations to establish supported earlier-to-later contributions and changes.",
      "depends_on": [
        "extraction"
      ]
    }
  ],
  "code_patterns": [
    "src/**/*.py",
    "config/**/*.json",
    "scripts/sherlock/environment.sh",
    "scripts/sherlock/atlas-account.sh",
    "scripts/sherlock/pipeline.sbatch",
    "experiments/method_intake_audit_20261113/preserve_bytes.py",
    "pyproject.toml",
    "uv.lock",
    "AGENTS.md"
  ],
  "actions": {
    "sources.refresh": {
      "stage": "sources",
      "native_models": false,
      "entrypoint": [
        "{python}",
        "-m",
        "experiments.method_intake_audit_20261113.refresh_discovery_pool"
      ],
      "code_patterns": [
        "experiments/method_intake_audit_20261113/refresh_discovery_pool.py"
      ],
      "inputs": {
        "inputs": "config/sources/refresh_inputs.json",
        "queries": "config/sources/search_queries.json",
        "prior_overlay": "${ATLAS_PROJECT_ROOT}/technology_atlas/v2/work/method_intake_audit_20261113/source_refresh_release_01/source_refresh_release_01/results_52178741/expand/OVERLAY.json"
      },
      "parameters": {
        "phase": "expand"
      },
      "arguments": [
        "--inputs",
        "{inputs}",
        "--plan",
        "{queries}",
        "--phase",
        "{phase}",
        "--output",
        "{output}",
        "--prior-overlay",
        "{prior_overlay}"
      ],
      "result": "output/OVERLAY.json",
      "notes": "Metadata/abstract acquisition reusing base+overlay. Override queries with config/sources/overlap_queries.json for pragmatic2010\u20132016 padding; older cited predecessors have no date floor. Full-article acquisition belongs to sources.prepare-publications."
    },
    "sources.screen": {
      "stage": "sources",
      "native_models": true,
      "entrypoint": [
        "{python}",
        "-m",
        "experiments.method_intake_audit_20261113.bulk_screen"
      ],
      "code_patterns": [
        "experiments/method_intake_audit_20261113/bulk_screen.py",
        "experiments/method_intake_audit_20261113/live_pilot.py"
      ],
      "inputs": {
        "pool": "${ATLAS_PROJECT_ROOT}/technology_atlas/v2/work/technology_sources_20261105/source_library_release_01/post_2016_discovery/candidate_papers.json",
        "runtime_manifest": "",
        "overlay": "${ATLAS_PROJECT_ROOT}/technology_atlas/v2/work/method_intake_audit_20261113/source_refresh_release_01/source_refresh_release_01/results_52178741/expand/OVERLAY.json"
      },
      "parameters": {
        "pool_sha256": "fd625c3e843642ef22ec7f57cb125b146f014a4b8b4682723bf5462ff9d354c9",
        "agents": "50",
        "batch_size": "20",
        "overlay_sha256": "f1ca75fc8a17ad1caa34bf59039dda65203d827bec36df711b8b479d2ca28d4e"
      },
      "arguments": [
        "--pool",
        "{pool}",
        "--pool-sha256",
        "{pool_sha256}",
        "--runtime-manifest",
        "{runtime_manifest}",
        "--agents",
        "{agents}",
        "--batch-size",
        "{batch_size}",
        "--output",
        "{output}",
        "--overlay",
        "{overlay}",
        "--overlay-sha256",
        "{overlay_sha256}"
      ],
      "result": "output/SCREENING.json",
      "notes": "One first-pass screen per batch. Model decisions do not admit a new method. Supply the selected frozen-runtime manifest."
    },
    "sources.acquire": {
      "stage": "sources",
      "native_models": true,
      "entrypoint": [
        "{python}",
        "-m",
        "genomics_discovery.sources.acquisition"
      ],
      "code_patterns": [],
      "inputs": {
        "worklist": ""
      },
      "parameters": {
        "concurrency": "2"
      },
      "arguments": [
        "{worklist}",
        "--concurrency",
        "{concurrency}",
        "--output",
        "{output}"
      ],
      "result": "output/result.json",
      "notes": "Uses the existing source-recovery worklist contract. Screening JSON is not automatically such a worklist; inspect/prepare the handoff first."
    },
    "extraction": {
      "stage": "extraction",
      "native_models": true,
      "entrypoint": [
        "{python}",
        "-m",
        "genomics_discovery.illumina.prepared",
        "run"
      ],
      "code_patterns": [],
      "inputs": {
        "sources": ""
      },
      "parameters": {
        "workers": "10",
        "max_revisions": "2"
      },
      "arguments": [
        "{sources}",
        "--workers",
        "{workers}",
        "--max-revisions",
        "{max_revisions}",
        "--output",
        "{output}"
      ],
      "result": "output/state.json",
      "notes": "Pinned prepared method bundles use the existing extract_registered_workflow harness, unchanged scientific prompts/schema, and 1-50 explicit workers. Accepted methods are excluded from continuation."
    },
    "extraction.recover": {
      "stage": "extraction",
      "native_models": true,
      "entrypoint": [
        "{python}",
        "-m",
        "genomics_discovery.illumina.prepared",
        "recover"
      ],
      "code_patterns": [
        "experiments/card_methods_full_20261112/investigate_holds.py",
        "experiments/card_methods_full_20261112/located_documents.py",
        "experiments/diagram_paper_pilot_20261106/run.py"
      ],
      "inputs": {
        "sources": "config/extraction/illumina_cards.json"
      },
      "parameters": {
        "workers": "25"
      },
      "arguments": [
        "{sources}",
        "--workers",
        "{workers}",
        "--output",
        "{output}"
      ],
      "result": "output/METHOD_LEDGER.json",
      "notes": "Reconcile pinned actual method states, retain accepted/provider-held cases, investigate exact source gaps, then extract/review genuinely enlarged bundles. Finders and sequential handoffs share the same 1-50 native slot limit."
    },
    "extraction.adjudicate": {
      "stage": "extraction",
      "native_models": true,
      "entrypoint": [
        "{python}",
        "-m",
        "genomics_discovery.illumina.prepared",
        "adjudicate"
      ],
      "code_patterns": [],
      "inputs": {
        "sources": ""
      },
      "parameters": {
        "workers": "4"
      },
      "arguments": [
        "{sources}",
        "--workers",
        "{workers}",
        "--output",
        "{output}"
      ],
      "result": "output/state.json",
      "notes": "Source/pointer-bound curation questions receive a fresh complete existing DiagramReview. Only an actual needs_revision verdict enters the existing one-correction revision_seed path; unavailable facts remain research-held. One slot stays reserved through all handoffs. No new scientific schema or verdict inheritance."
    },
    "evolution": {
      "stage": "evolution",
      "native_models": true,
      "entrypoint": [
        "{python}",
        "{repo}/experiments/citation_lineage_pilot/run.py",
        "run"
      ],
      "code_patterns": [
        "experiments/citation_lineage_pilot/*.py",
        "experiments/history_contract_audit_20261113/focused_reading.py"
      ],
      "inputs": {
        "batch_state": "",
        "article": "",
        "inventory": ""
      },
      "parameters": {
        "record": "",
        "paper": "",
        "reading_policy": "focused"
      },
      "arguments": [
        "--batch-state",
        "{batch_state}",
        "--article",
        "{article}",
        "--inventory",
        "{inventory}",
        "--record",
        "{record}",
        "--paper",
        "{paper}",
        "--reading-policy",
        "{reading_policy}",
        "--output",
        "{output}"
      ],
      "result": "output/graph.json",
      "notes": "Current citation-investigation driver remains a pilot at this listed path. Edit it in place. Exact earlier workflow mapping is optional; supported history and comparisons remain distinct."
    },
    "sources.prepare-publications": {
      "stage": "sources",
      "native_models": true,
      "entrypoint": [
        "{python}",
        "-m",
        "genomics_discovery.sources.publication_intake"
      ],
      "code_patterns": [
        "experiments/method_intake_audit_20261113/bulk_screen.py",
        "experiments/method_intake_audit_20261113/live_pilot.py",
        "experiments/method_intake_audit_20261113/test_bulk_screen.py",
        "scripts/illumina/technology_sources/*.py",
        "tests/sources/test_publication_intake.py"
      ],
      "inputs": {
        "config": "config/sources/publication_intake.json"
      },
      "parameters": {},
      "arguments": [
        "--config",
        "{config}",
        "--output",
        "{output}"
      ],
      "result": "output/RESULTS.json",
      "notes": "One initial abstract screen per batch, streaming assay/library/component/unclear/review/later-protocol candidates to existing identity-checked public-paper acquisition. Native concurrency is configured with a total ceiling of50 across tracks; source run selects25 while extraction reserves25. No automatic method admission."
    },
    "sources.repair-validation": {
      "stage": "sources",
      "native_models": true,
      "entrypoint": [
        "{python}",
        "-m",
        "experiments.method_intake_audit_20261113.bulk_screen",
        "repair"
      ],
      "code_patterns": [
        "experiments/method_intake_audit_20261113/bulk_screen.py",
        "experiments/method_intake_audit_20261113/live_pilot.py",
        "experiments/method_intake_audit_20261113/test_bulk_screen.py",
        "scripts/illumina/technology_sources/*.py"
      ],
      "inputs": {
        "config": "config/sources/validation_repair.json"
      },
      "parameters": {},
      "arguments": [
        "--config",
        "{config}",
        "--output",
        "{output}"
      ],
      "result": "output/VALIDATION_REPAIR.json",
      "notes": "Single bounded correction of invalid evidence rows from complete successful transport; no providerblocked retry, no rerunofvalidpapers, originalartifactsunchanged. One global slot explicitly reserved within50."
    },
    "sources.recover-assigned-primaries": {
      "stage": "sources",
      "native_models": false,
      "entrypoint": [
        "{python}",
        "-m",
        "genomics_discovery.sources.publication_intake",
        "recover-primaries"
      ],
      "code_patterns": [
        "experiments/card_methods_full_20261112/located_documents.py",
        "experiments/method_intake_audit_20261113/bulk_screen.py",
        "experiments/method_intake_audit_20261113/live_pilot.py",
        "scripts/illumina/technology_sources/*.py",
        "tests/sources/test_publication_intake.py"
      ],
      "inputs": {
        "config": "config/sources/assigned_primary_recovery.json"
      },
      "parameters": {},
      "arguments": [
        "--config",
        "{config}",
        "--output",
        "{output}"
      ],
      "result": "output/RESULTS.json",
      "notes": "Zero-model exact assigned-primary recovery: check full publication vault and bulk-acquisition cache; reuse pinned approved OA metadata; try only new public original routes. Failed URLs/challenge hosts are held without repetition. Original-byte identity and existing registration precede handoff; fresh scientific review remains required."
    },
    "evolution.batch": {
      "stage": "evolution",
      "native_models": true,
      "entrypoint": [
        "{python}",
        "-m",
        "experiments.history_changes_20261106.run"
      ],
      "code_patterns": [
        "experiments/history_changes_20261106/*.py",
        "experiments/citation_lineage_pilot/*.py",
        "experiments/pilot50_20261104/history_stage.py",
        "experiments/diagram_paper_pilot_20261106/run.py",
        "experiments/history_parallel_20261112/prepare.py",
        "experiments/history_contract_audit_20261113/focused_reading.py",
        "experiments/history_parallel_20261112/merge_completed.py"
      ],
      "inputs": {
        "batch_state": "",
        "method_inventory": "",
        "selection": "",
        "library_inventory": "",
        "completed_catalog": ""
      },
      "parameters": {
        "batch": "",
        "library": "",
        "vault": "",
        "agents": "18",
        "max_ready_seeds": "20",
        "reading_policy": "focused"
      },
      "arguments": [
        "--batch",
        "{batch}",
        "--library",
        "{library}",
        "--vault",
        "{vault}",
        "--runtime",
        "{repo}",
        "--output",
        "{output}",
        "--method-inventory",
        "{method_inventory}",
        "--selection",
        "{selection}",
        "--agents",
        "{agents}",
        "--max-ready-seeds",
        "{max_ready_seeds}",
        "--reading-policy",
        "{reading_policy}",
        "--software-preflight",
        "--citation-only",
        "--batch-state",
        "{batch_state}",
        "--completed-catalog",
        "{completed_catalog}",
        "--library-inventory",
        "{library_inventory}"
      ],
      "result": "output/RESULT.json",
      "notes": "Existing history runner with canonical all-run completion join, exact source/workflow/policy identities, explicit revisit/recovery reasons, pinned state-directory consistency and bounded scheduling. No completed history is rerun merely because absent from a display merge."
    },
    "extraction.recover-review": {
      "stage": "extraction",
      "native_models": true,
      "entrypoint": [
        "{python}",
        "-m",
        "genomics_discovery.illumina.review_recovery"
      ],
      "code_patterns": [
        "experiments/card_methods_full_20261112/investigate_holds.py",
        "experiments/card_methods_full_20261112/located_documents.py",
        "experiments/diagram_paper_pilot_20261106/run.py"
      ],
      "inputs": {
        "policy": "config/extraction/review_recovery.json",
        "checkpoints": ""
      },
      "parameters": {
        "workers": "1"
      },
      "arguments": [
        "{checkpoints}",
        "--policy",
        "{policy}",
        "--workers",
        "{workers}",
        "--output",
        "{output}"
      ],
      "result": "output/state.json",
      "notes": "Pinned actual completed research checkpoints enter bounded existing recovery directly, with no preliminary author/reviewer. Cache and source custody precede any new extraction; same episode resumes without duplicate calls. Declare purpose and pinned inventories/curation inputs in the checkpoint manifest. Fresh scientific review remains mandatory; no canonical admission is implied."
    }
  },
  "history": "provenance/ and dated experiments preserve earlier inputs, code and outcomes. They are not a menu of interchangeable current launchers.",
  "model": "gpt-6.1-sol",
  "effort": "xhigh"
}
